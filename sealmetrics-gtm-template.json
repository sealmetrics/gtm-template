        "type": "html",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n(function() {\n  // Configuration - REPLACE WITH YOUR ACCOUNT ID\n  var ACCOUNT_ID = '{{SealMetrics Account ID}}';\n  var PIXEL_URL = '{{SealMetrics Pixel URL}}';\n  \n  if (!ACCOUNT_ID || ACCOUNT_ID === '') {\n    console.warn('SealMetrics: Account ID not configured');\n    return;\n  }\n  \n  // Load tracker script\n  var script = document.createElement('script');\n  script.src = PIXEL_URL + '/t.js?id=' + ACCOUNT_ID;\n  script.defer = true;\n  document.head.appendChild(script);\n})();\n</script>"
          },
