          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n(function() {\n  var eventType = '{{Micro Event Type}}';\n  var eventProperties = {{Micro Event Properties}};\n  var retries = 0;\n  \n  function trackMicro() {\n    if (typeof sealmetrics !== 'undefined' && sealmetrics.micro) {\n      sealmetrics.micro(eventType, eventProperties || {});\n    } else if (retries < 50) {\n      retries++;\n      setTimeout(trackMicro, 100);\n    }\n  }\n  \n  if (document.readyState === 'complete') {\n    trackMicro();\n  } else {\n    window.addEventListener('load', trackMicro);\n  }\n})();\n</script>"
          },
