        "accountId": "0",
        "containerId": "0",
        "tagId": "4",
        "name": "SealMetrics - E-commerce Purchase",
        "type": "html",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n(function() {\n  // Get e-commerce data from dataLayer\n  var ecommerce = {{Ecommerce Data}} || {};\n  var purchase = ecommerce.purchase || ecommerce;\n  var actionField = purchase.actionField || {};\n  var products = purchase.products || [];\n  \n  var revenue = parseFloat(actionField.revenue || 0);\n  var currency = actionField.currency || 'EUR';\n  \n  var items = products.map(function(p) {\n    return {\n      product_name: p.name || '',\n      product_id: String(p.id || ''),\n      sku: p.sku || String(p.id || ''),\n      price: Number(p.price || 0),\n      quantity: Number(p.quantity || 1),\n      category: p.category || '',\n      brand: p.brand || ''\n    };\n  });\n  \n  var properties = {\n    currency: currency,\n    items: items\n  };\n  \n  if (actionField.coupon) {\n    properties.coupon = actionField.coupon;\n  }\n  \n  var retries = 0;\n  function trackPurchase() {\n    if (typeof sealmetrics !== 'undefined' && sealmetrics.conv) {\n      sealmetrics.conv('purchase', revenue, properties);\n    } else if (retries < 50) {\n      retries++;\n      setTimeout(trackPurchase, 100);\n    }\n  }\n  \n  if (document.readyState === 'complete') {\n    trackPurchase();\n  } else {\n    window.addEventListener('load', trackPurchase);\n  }\n})();\n</script>"
          },
