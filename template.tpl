___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const log = require('logToConsole');
const injectScript = require('injectScript');
const callInWindow = require('callInWindow');
const makeTableMap = require('makeTableMap');
const getType = require('getType');
const encodeUriComponent = require('encodeUriComponent');

// Build tracker script URL
var pixelUrl = data.pixelUrl || 'https://t.sealmetrics.com';
var scriptUrl = pixelUrl + '/t.js?id=' + encodeUriComponent(data.accountId);

// Add content grouping for pageviews
if (data.eventType === 'pageview' && data.contentGrouping) {
  scriptUrl = scriptUrl + '&group=' + encodeUriComponent(data.contentGrouping);
}

// Cache token ensures script loads only once per page.
// Subsequent tags (conversion/micro) reuse the cached script
// and execute onSuccess immediately.
var cacheToken = 'sealmetrics_' + data.accountId;

// Build custom properties object
var properties = null;
if (data.properties && getType(data.properties) === 'array' && data.properties.length > 0) {
  properties = makeTableMap(data.properties, 'key', 'value');
}

if (data.eventType === 'pageview') {
  // Pageview: just inject the tracker script (it auto-tracks the pageview)
  injectScript(scriptUrl, data.gtmOnSuccess, data.gtmOnFailure, cacheToken);

} else if (data.eventType === 'conversion') {
  // Conversion: inject script, then call sealmetrics.conv()
  var amount = data.amount ? data.amount * 1 : 0;
  injectScript(scriptUrl, function() {
    if (properties) {
      callInWindow('sealmetrics.conv', data.label, amount, properties);
    } else {
      callInWindow('sealmetrics.conv', data.label, amount);
    }
    data.gtmOnSuccess();
  }, data.gtmOnFailure, cacheToken);

} else if (data.eventType === 'microconversion') {
  // Microconversion: inject script, then call sealmetrics.micro()
  injectScript(scriptUrl, function() {
    if (properties) {
      callInWindow('sealmetrics.micro', data.label, properties);
    } else {
      callInWindow('sealmetrics.micro', data.label);
    }
    data.gtmOnSuccess();
  }, data.gtmOnFailure, cacheToken);
}


