      {
        "accountId": "0",
        "containerId": "0",
        "tagId": "2",
        "name": "SealMetrics - Conversion",
        "type": "html",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n(function() {\n  var conversionType = '{{Conversion Type}}';\n  var conversionValue = {{Conversion Value}};\n  var conversionProperties = {{Conversion Properties}};\n  var retries = 0;\n  \n  function trackConversion() {\n    if (typeof sealmetrics !== 'undefined' && sealmetrics.conv) {\n      sealmetrics.conv(conversionType, conversionValue, conversionProperties || {});\n    } else if (retries < 50) {\n      retries++;\n      setTimeout(trackConversion, 100);\n    }\n  }\n  \n  if (document.readyState === 'complete') {\n    trackConversion();\n  } else {\n    window.addEventListener('load', trackConversion);\n  }\n})();\n</script>"
          },
          {
            "type": "BOOLEAN",
            "key": "supportDocumentWrite",
            "value": "false"
          }
